{
  "manifest_version": 3,
  "name": "N&N Digitals Social MCP Bridge",
  "version": "1.0.0",
  "description": "Connect your signed-in LinkedIn, Facebook and Instagram browser sessions to AI tools through the N&N Digitals MCP service.",
  "permissions": ["cookies", "scripting", "tabs", "storage", "alarms"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://api.nndigitals.com/*",
    "wss://api.nndigitals.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Social MCP Bridge" }
}
